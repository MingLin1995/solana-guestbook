{
  "name": "solana-guestbook",
  "version": "0.1.0",
  "private": true,
  "description": "Web3 Edge Fullstack Application: On-Chain Guestbook with Solana, Cloudflare Workers & React",
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
